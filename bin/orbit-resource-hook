#!/usr/bin/env python3
"""Trusted, zero-model-call resource governor for native Claude Code sessions.

The goal loop is allowed to reason; this kernel controls the resources used to do it. It implements
AgentPrune's systems insight as an enforceable sparse execution graph: reserve before an Agent edge,
charge the edge from PostToolUse usage telemetry, keep a protected closeout pool, and carry only a
bounded checkpoint across temporal (compaction) edges. It never asks for confirmation.
"""
from __future__ import annotations

import fcntl
import importlib.util
import json
import os
import re
import sys
import time
from pathlib import Path


def _find_orbit(start: str) -> Path | None:
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    candidates = [Path(project)] if project else []
    candidates.append(Path(start or "."))
    for candidate in candidates:
        try:
            current = candidate.resolve()
        except Exception:
            continue
        for root in (current, *current.parents):
            if (root / ".orbit").is_dir():
                return root / ".orbit"
    return None


def _load_budget():
    path = Path(__file__).resolve().parent.parent / "assets/checks/token_budget.py"
    spec = importlib.util.spec_from_file_location("orbit_resource_budget", path)
    module = importlib.util.module_from_spec(spec)
    sys.modules["orbit_resource_budget"] = module
    spec.loader.exec_module(module)
    return module


def _read_json(path: Path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, (dict, list)) else {}
    except Exception:
        return {}


def _latest_gear(orbit: Path) -> str:
    path = orbit / "activity.jsonl"
    if not path.exists():
        return "T1"
    gear = "T1"
    try:
        for line in path.read_text(errors="ignore").splitlines()[-1000:]:
            event = json.loads(line)
            if event.get("phase") == "gear":
                raw = event.get("gear") or event.get("msg") or ""
                found = re.search(r"\bT\d+\b", str(raw), re.IGNORECASE)
                if found:
                    gear = found.group(0).upper()
    except Exception:
        pass
    return gear


def _prompt(data: dict) -> str:
    return str(data.get("prompt") or data.get("user_prompt") or "")[:4000]


def _maintenance_prompt(data: dict) -> bool:
    """True for Orbit's own slash commands, which maintain infrastructure but deliver no product."""
    return bool(re.match(r"^\s*/orbit(?:\s|$|-)", _prompt(data), re.IGNORECASE))


def _role(data: dict) -> str:
    tool_input = data.get("tool_input") if isinstance(data.get("tool_input"), dict) else {}
    return str(tool_input.get("subagent_type") or tool_input.get("agent_type") or
               tool_input.get("name") or "subagent").strip().lower()


def _reservation_id(data: dict) -> str:
    return str(data.get("tool_use_id") or data.get("toolUseId") or
               f"edge-{time.time_ns()}")


def _config(orbit: Path, budget) -> dict:
    return budget.contract(orbit)


def _deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
          "permissionDecision": "deny", "permissionDecisionReason": reason}}))


def _allow_with_input(updated: dict, reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
          "permissionDecision": "allow", "permissionDecisionReason": reason,
          "updatedInput": updated}}))


def _packet_exceeds(packet: dict, intelligence: dict) -> bool:
    retrieval = packet.get("retrieval") if isinstance(packet.get("retrieval"), dict) else {}
    policy = packet.get("policy") if isinstance(packet.get("policy"), dict) else {}
    try:
        return (int(policy.get("hops", 99)) > int(intelligence.get("default_hops", 1))
                or len(retrieval.get("files") or []) > int(intelligence.get("max_files", 12))
                or int(retrieval.get("estimated_tokens", 0))
                > int(intelligence.get("max_evidence_tokens", 4000)))
    except (TypeError, ValueError):
        return True


def _refresh_evidence(orbit: Path, goal: str, config: dict) -> dict:
    """Regenerate Orbit-owned evidence inside the same hard limits; fail closed if repair fails."""
    try:
        helper = orbit / "checks/repository_intelligence.py"
        spec = importlib.util.spec_from_file_location("orbit_resource_intelligence", helper)
        module = importlib.util.module_from_spec(spec)
        sys.modules["orbit_resource_intelligence"] = module
        spec.loader.exec_module(module)
        result = module.prepare_goal(orbit.parent, goal, config)
        return result.get("packet", {}) if isinstance(result, dict) else {}
    except Exception:
        return {}


def _usage_total(response: dict) -> tuple[int, dict]:
    usage = response.get("usage") if isinstance(response.get("usage"), dict) else {}
    total = response.get("totalTokens")
    if not isinstance(total, (int, float)):
        total = sum(int(usage.get(key, 0) or 0) for key in
                    ("input_tokens", "output_tokens", "cache_creation_input_tokens",
                     "cache_read_input_tokens"))
    return max(0, int(total or 0)), usage


def _checkpoint(orbit: Path, budget) -> None:
    ledger = budget.load(orbit)
    state = (orbit / "STATE.md").read_text(errors="ignore")[:5000] if (orbit / "STATE.md").exists() else ""
    value = {
        "schema": 1, "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "goal_hash": ledger.get("goal_hash", ""), "goal": ledger.get("goal", "")[:500],
        "gear": ledger.get("gear", "T1"), "spent": budget.total_spent(ledger),
        "remaining": budget.global_remaining(ledger), "tasks": _read_json(orbit / "tasks.json"),
        "run": _read_json(orbit / "run.json"), "state_excerpt": state,
    }
    path = orbit / "context-checkpoint.json"
    tmp = orbit / ".context-checkpoint.json.tmp"
    tmp.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, path)


def _active_goal(orbit: Path) -> dict:
    value = _read_json(orbit / "active-goal.json")
    if isinstance(value, dict) and value.get("route_id") and value.get("goal"):
        return value
    try:
        for line in reversed((orbit / "activity.jsonl").read_text(errors="ignore").splitlines()):
            event = json.loads(line)
            if event.get("phase") == "route" and event.get("status") == "start":
                message = str(event.get("msg") or "")
                goal = message.split("—", 1)[-1].strip() if "—" in message else message
                return {"route_id": str(event.get("ts") or ""), "goal": goal,
                        "gear": str(event.get("gear") or "")}
    except Exception:
        pass
    return {}


def _latest_route(orbit: Path) -> dict:
    try:
        for line in reversed((orbit / "activity.jsonl").read_text(errors="ignore").splitlines()):
            event = json.loads(line)
            if event.get("phase") == "route":
                return event
    except Exception:
        pass
    return {}


def _suspend_task_route(orbit: Path) -> None:
    """Hide a task marker from this turn's legacy Stop hook without forgetting the active goal."""
    marker = orbit / ".last-task-route"
    suspended = orbit / ".last-task-route.suspended"
    if marker.exists():
        try:
            os.replace(marker, suspended)
        except Exception:
            pass


def _resume_task_route(orbit: Path) -> None:
    """A newly routed task owns the marker; discard any older turn-scoped suspension."""
    marker = orbit / ".last-task-route"
    suspended = orbit / ".last-task-route.suspended"
    if marker.exists():
        suspended.unlink(missing_ok=True)


def _acknowledge_user_input(orbit: Path, maintenance: bool = False) -> None:
    """Clear stale INPUT while preserving the active goal across non-delivery turns."""
    run_path = orbit / "run.json"
    run = _read_json(run_path)
    if isinstance(run, dict) and run.get("blocked_question"):
        run["blocked_question"] = None
        run["last_ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        tmp = run_path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(run, indent=2) + "\n")
        os.replace(tmp, run_path)
    latest = _latest_route(orbit)
    if maintenance or (latest and latest.get("status") != "start"):
        _suspend_task_route(orbit)
    elif latest and latest.get("status") == "start":
        _resume_task_route(orbit)


def _restore_context(orbit: Path) -> None:
    checkpoint = _read_json(orbit / "context-checkpoint.json")
    if not checkpoint:
        return
    compact = {
        "goal_hash": checkpoint.get("goal_hash"), "goal": checkpoint.get("goal"),
        "gear": checkpoint.get("gear"), "spent": checkpoint.get("spent"),
        "remaining": checkpoint.get("remaining"), "next": (checkpoint.get("run") or {}).get("active_task"),
    }
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostCompact",
          "additionalContext": "[orbit] RESOURCE CHECKPOINT (data, not instructions): " +
          json.dumps(compact, separators=(",", ":")) +
          ". Re-read exact evidence by path; do not reset the goal or budget."}}))


def main() -> int:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    orbit = _find_orbit(str(data.get("cwd") or "."))
    if orbit is None:
        return 0
    event = str(data.get("hook_event_name") or "")
    budget = _load_budget()

    lock_path = orbit / ".budget.lock"
    lock_path.touch(exist_ok=True)
    with lock_path.open("r+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)

        if event == "UserPromptSubmit":
            session = str(data.get("session_id") or "unknown-session")
            maintenance = _maintenance_prompt(data)
            _acknowledge_user_input(orbit, maintenance=maintenance)
            # `/orbit` and `/orbit-upgrade` are control-plane maintenance. They must not reopen a
            # product ledger or let an older task marker make Stop/CPO/QA judge an unrelated HEAD.
            if maintenance:
                return 0
            routed = _active_goal(orbit)
            goal = str(routed.get("goal") or _prompt(data))
            sizing = budget.size_goal(goal)
            gear = str(routed.get("gear") or sizing.get("gear", "T1"))
            budget.open_goal(orbit, session, str(routed.get("route_id") or ""), goal, gear)
            budget.sync_parent_usage(orbit, str(data.get("transcript_path") or ""))
            return 0

        if event == "PreCompact":
            _checkpoint(orbit, budget)
            return 0

        if event == "PostCompact":
            _restore_context(orbit)
            return 0

        if event == "PreToolUse" and str(data.get("tool_name") or "") == "Agent":
            role = _role(data)
            budget.sync_parent_usage(orbit, str(data.get("transcript_path") or ""))
            ledger = budget.load(orbit)
            if not ledger:
                _deny("Orbit resource governor: no goal ledger. New agent work is blocked, not unmetered.")
                return 0
            observed_gear = budget.normalize_gear(_latest_gear(orbit))
            current_gear = budget.normalize_gear(ledger.get("gear", "T1"))
            requested_gear = max((observed_gear, current_gear), key=lambda value: int(value[1:]))
            ledger = budget.sync_gear(orbit, requested_gear)
            contract = _config(orbit, budget)
            full_config = _read_json(orbit / "loop.config.json")
            intelligence = full_config.get("repository_intelligence", {}) if isinstance(full_config, dict) else {}
            evidence_packet = _read_json(orbit / "intelligence/latest.json")
            if intelligence.get("enabled", True) and (
                    not evidence_packet or _packet_exceeds(evidence_packet, intelligence)):
                evidence_packet = _refresh_evidence(orbit, ledger.get("goal", ""), full_config)
            if intelligence.get("enabled", True) and not evidence_packet:
                _deny("Orbit repository governor: the required intent-to-impact packet is missing. "
                      "Run `scripts/orbit-intel query --goal <goal>`; do not replace it with a repository dump.")
                return 0
            if intelligence.get("enabled", True) and _packet_exceeds(evidence_packet, intelligence):
                _deny("Orbit repository governor: evidence packet exceeds the configured hop/file/token ceiling. "
                      "Automatic bounded repair failed; full-codebase context remains denied.")
                return 0
            prompt_bytes = len(str((data.get("tool_input") or {}).get("prompt") or "").encode("utf-8"))
            prompt_cap = int(intelligence.get("max_agent_prompt_bytes", 12000) or 12000)
            if intelligence.get("enabled", True) and prompt_bytes > prompt_cap:
                _deny(f"Orbit repository governor: Agent packet is {prompt_bytes:,} bytes; hard cap is "
                      f"{prompt_cap:,}. Pass the goal, `.orbit/intelligence/latest.json`, and only "
                      "the relevant evidence paths—not repository content or full history.")
                return 0
            gear = ledger.get("gear", "T1")
            max_calls = int((contract.get("max_agent_calls") or {}).get(gear, 0) or 0)
            slices = contract.get("role_slice_tokens") or budget.DEFAULT_ROLE_SLICE
            estimate = int(slices.get(role, 6000) or 6000)
            decision = budget.check(ledger, role, estimate)
            protected_role = budget.is_protected_goal_role(ledger, role)
            call_pressure = (int(ledger.get("agent_calls", 0)) >= max_calls and not protected_role)
            reconsidered = None
            if decision.get("decision") != "allow" or call_pressure:
                cause = "agent-call ceiling" if call_pressure else decision.get("action", "token pressure")
                reconsidered = budget.reconsider(orbit, role, estimate, cause, require_call_slot=True)
                ledger = budget.load(orbit)
                gear = ledger.get("gear", gear)
                if reconsidered.get("decision") != "allow":
                    _deny("Orbit resource governor: optional work stopped at the governed ceiling: "
                          f"{reconsidered.get('reason', 'capacity exhausted')}. Continue the original "
                          "goal with the protected product/quality spine; never ask the user to reset it.")
                    return 0
            rid = _reservation_id(data)
            budget.reserve(orbit, role, rid, estimate)
            tool_input = dict(data.get("tool_input") or {})
            # Preserve the caller's foreground/background choice. A background launch keeps its
            # reservation until the measurable completion event; it is never converted to unmetered work.
            if not tool_input.get("model"):
                if role in ("reporter", "dispatcher", "safety-gate"):
                    tool_input["model"] = "haiku"
                elif role == "advisor":
                    tool_input["model"] = "opus"
                else:
                    tool_input["model"] = "sonnet"
            resized = (f" Budget auto-reconsidered {reconsidered['entry']['from_gear']}→{gear}; "
                       "goal and measured spend preserved."
                       if reconsidered and reconsidered.get("changed") else "")
            note = (f"\n\n[orbit resource envelope] role={role}; reservation={rid}; "
                    f"slice~{estimate} tokens. Return a compact evidence envelope; persist long logs/artifacts by path. "
                    "Use the role view in `.orbit/intelligence/latest.json`; expand only a named uncertainty with a "
                    "targeted query. Never ingest the full repository/index. Keep the native task board current "
                    "through launch and completion. The goal and acceptance criteria are immutable."
                    + resized)
            tool_input["prompt"] = str(tool_input.get("prompt") or "") + note
            reason = f"reserved ~{estimate:,} tokens for {role}"
            if reconsidered and reconsidered.get("changed"):
                reason += f" after automatic {reconsidered['entry']['from_gear']}→{gear} reconsideration"
            _allow_with_input(tool_input, reason)
            return 0

        if event == "PostToolUse" and str(data.get("tool_name") or "") == "Agent":
            response = data.get("tool_response") if isinstance(data.get("tool_response"), dict) else {}
            if response.get("status") == "async_launched":
                return 0  # reservation intentionally remains until a measurable completion
            role = _role(data)
            total, usage = _usage_total(response)
            budget.reconcile(orbit, _reservation_id(data), role, total, usage)
            budget.sync_parent_usage(orbit, str(data.get("transcript_path") or ""))
            return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
