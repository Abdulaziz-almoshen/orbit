#!/usr/bin/env bash
# Project wrapper for the trusted Orbit token budget ledger.
set -u
cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || true
for p in "${CLAUDE_PLUGIN_ROOT:-}/bin/orbit-budget" \
         "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/orbit/bin/orbit-budget" \
         "$HOME"/.claude/plugins/cache/*/orbit/*/bin/orbit-budget \
         "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/plugins/cache/*/orbit/*/bin/orbit-budget; do
  [ -f "$p" ] && exec python3 "$p" "$@"
done
echo "orbit-budget: trusted Orbit install not found" >&2
exit 1
